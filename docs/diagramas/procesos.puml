' Regenerar: java -jar plantuml.jar -charset UTF-8 -tsvg docs/diagramas/procesos.puml
@startuml procesos
!pragma layout smetana

title Lucas (MVP): diagrama de actividad del uso

|Cliente|
start
:Ingresa a Banco Vértice\ny elige su persona;

|Pantallas de Lucas|
if (¿Dio su permiso?) then (no)
  :Muestra /consentimiento;
  |Cliente|
  if (¿Acepta?) then («Ahora no»)
    :Sigue en la banca sin Lucas;
    stop
  else (sí)
  endif
else (sí)
endif

|Navegador|
:Lee de localStorage la persona,\ntips elegidos, planificados y metas;

fork
  |Motor|
  repeat :vistaCon(elegidos, personaId,\npagosExtra, planificados);
    note right
      Única fuente de cifras:
      saldo con banda, peor día,
      días en rojo, gasto diario seguro.
      Al volver aquí, todas las
      pantallas cambian juntas.
    end note
    |Pantallas de Lucas|
    :Resumen, Qué viene, Avisos,\nMetas y Chat pintan la misma vista;
    if (¿El cliente pulsa «Lo hago»,\nplanifica o crea una meta?) then (sí)
      :Guarda la decisión\nen localStorage;
    elseif (¿Pregunta en el chat?) then (sí)
      :Responde con cifras de la vista\n(ver secuencia del chat);
    else (retira su permiso)
      :Borra de localStorage\nlo de esa persona;
      stop
    endif
  repeat while (¿Sigue usando Lucas?) is (sí)
fork again
  |Pantallas de Lucas|
  :cargarCliente lee la API\n(espera ESPERA_MS = 4 s por ruta);
  if (¿Respondió con la forma esperada?) then (sí)
    :Marca los datos como recibidos;
  else (red, 404, 500, espera o formato)
    :Usa data/sample/mocks/ y avisa\n«Sin conexión: te muestro tus últimos datos.»;
  endif
  note right
    Las cifras de pantalla
    no cambian: salen del motor
  end note
end fork
stop

@enduml

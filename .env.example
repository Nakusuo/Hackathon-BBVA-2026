# Copiar a .env y completar. El .env nunca se sube al repo.

# Agente
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
# ahorro: el LLM solo redacta lo que una plantilla no cubre bien. siempre: redacta todo (más lento).
LLM_USO=ahorro
# Solo si la organización autoriza Gemini y LLM_PROVIDER=gemini. Proyecto de AI Studio sin facturación.
GEMINI_API_KEY=xxxx

# Base de datos local (docker compose up -d). Valores ficticios: cada quien pone su clave.
POSTGRES_USER=lucas
POSTGRES_PASSWORD=cambiar-esta-clave
POSTGRES_DB=lucas
DATABASE_URL=postgresql://lucas:cambiar-esta-clave@127.0.0.1:5432/lucas
# postgres: los modelos leen el esquema `lucas` de la base. parquet (por defecto): leen data/generado.
LUCAS_FUENTE_DATOS=postgres
# Ids que manda el front → cliente sintético de la base.
LUCAS_CLIENTES_DEMO=demo-001=C00016,independiente=C00016,formal=C00168

# Copia este archivo a .env y completa los valores. No subas .env.

# Proveedor del LLM que redacta las respuestas: gemini | compatible | ollama | plantillas
#   gemini      -> API de Gemini (la que se usa en las pruebas)
#   compatible  -> cualquier API con formato chat/completions (OpenAI, Azure OpenAI, un gateway interno, vLLM...): solo hay que llenar LLM_BASE_URL, LLM_API_KEY y LLM_MODEL
#   ollama      -> modelo local (nada sale de la maquina)
#   plantillas  -> sin LLM: respuestas deterministas (sirve para pruebas y como respaldo)
# Si el proveedor falla, el agente prueba Ollama local y, si tampoco responde, contesta con plantillas.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Para conectar otra API de IA: LLM_PROVIDER=compatible y estas tres variables
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Politica de uso del LLM: ahorro (solo lo que una plantilla no cubre bien) | siempre (todas las respuestas pasan por el LLM)
LLM_USO=ahorro
# Juez LLM opcional (la verificacion de cifras es siempre determinista)
JUEZ_LLM=0

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
